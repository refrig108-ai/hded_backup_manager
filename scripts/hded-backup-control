#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "This command must be run as root." >&2
  exit 1
fi

TIMER_UNIT="/etc/systemd/system/hded-erp-backup.timer"
SERVICE="hded-erp-backup.service"
TIMER="hded-erp-backup.timer"

need_argc() {
  local expected="$1"
  shift
  if [[ $# -ne "$expected" ]]; then
    echo "Invalid arguments." >&2
    exit 2
  fi
}

valid_flag() { [[ "$1" =~ ^[01]$ ]]; }
valid_time() { [[ "$1" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; }

case "${1:-}" in
  start)
    need_argc 0 "${@:2}"
    if systemctl is-active --quiet "$SERVICE"; then
      echo "Backup service is already running." >&2
      exit 3
    fi
    systemctl start --no-block "$SERVICE"
    echo "Backup service start requested."
    ;;
  set-schedule)
    need_argc 8 "${@:2}"
    daily_enabled="$2"; daily_time="$3"
    weekly_enabled="$4"; weekday="$5"; weekly_time="$6"
    monthly_enabled="$7"; month_day="$8"; monthly_time="$9"
    valid_flag "$daily_enabled" && valid_flag "$weekly_enabled" && valid_flag "$monthly_enabled" || { echo "Schedule flags must be 0 or 1." >&2; exit 2; }
    valid_time "$daily_time" && valid_time "$weekly_time" && valid_time "$monthly_time" || { echo "Time must be HH:MM in 24-hour format." >&2; exit 2; }
    [[ "$weekday" =~ ^(Mon|Tue|Wed|Thu|Fri|Sat|Sun)$ ]] || { echo "Invalid weekday." >&2; exit 2; }
    [[ "$month_day" =~ ^([1-9]|1[0-9]|2[0-8])$ ]] || { echo "Month day must be 1-28." >&2; exit 2; }

    calendar_lines=()
    [[ "$daily_enabled" == "1" ]] && calendar_lines+=("OnCalendar=*-*-* ${daily_time}:00")
    [[ "$weekly_enabled" == "1" ]] && calendar_lines+=("OnCalendar=${weekday} *-*-* ${weekly_time}:00")
    [[ "$monthly_enabled" == "1" ]] && calendar_lines+=("OnCalendar=*-*-$(printf '%02d' "$month_day") ${monthly_time}:00")
    # A disabled timer still needs a syntactically valid OnCalendar value in its unit.
    if [[ ${#calendar_lines[@]} -eq 0 ]]; then
      calendar_lines+=("OnCalendar=*-*-* 02:00:00")
    fi

    tmp="${TIMER_UNIT}.tmp.$$"
    trap 'rm -f "$tmp"' EXIT
    {
      echo "[Unit]"
      echo "Description=HDED ERP Backup Schedule"
      echo
      echo "[Timer]"
      for line in "${calendar_lines[@]}"; do echo "$line"; done
      echo "Persistent=true"
      echo "AccuracySec=1min"
      echo "Unit=${SERVICE}"
      echo
      echo "[Install]"
      echo "WantedBy=timers.target"
    } > "$tmp"
    install -o root -g root -m 0644 "$tmp" "$TIMER_UNIT"
    rm -f "$tmp"
    trap - EXIT
    systemctl daemon-reload
    if systemctl is-active --quiet "$TIMER"; then
      systemctl restart "$TIMER"
    fi
    echo "Backup schedules updated."
    ;;
  set-time)
    need_argc 1 "${@:2}"
    valid_time "$2" || { echo "Time must be HH:MM in 24-hour format." >&2; exit 2; }
    set -- set-schedule 1 "$2" 0 Sun 02:00 0 1 02:00
    exec "$0" "$@"
    ;;
  enable)
    need_argc 0 "${@:2}"
    systemctl enable --now "$TIMER"
    echo "Backup timer enabled."
    ;;
  disable)
    need_argc 0 "${@:2}"
    systemctl disable --now "$TIMER"
    echo "Backup timer disabled."
    ;;
  status)
    need_argc 0 "${@:2}"
    timer_active="$(systemctl is-active "$TIMER" 2>/dev/null || true)"
    service_active="$(systemctl is-active "$SERVICE" 2>/dev/null || true)"
    service_result="$(systemctl show "$SERVICE" -p Result --value 2>/dev/null || true)"
    next_run="$(systemctl show "$TIMER" -p NextElapseUSecRealtime --value 2>/dev/null || true)"
    last_trigger="$(systemctl show "$TIMER" -p LastTriggerUSec --value 2>/dev/null || true)"
    backup_time="$(sed -nE 's/^OnCalendar=.* ([0-2][0-9]:[0-5][0-9]):00$/\1/p' "$TIMER_UNIT" 2>/dev/null | head -n 1)"
    [[ "$backup_time" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || backup_time="02:00"
    printf 'TIMER_ACTIVE=%s\nSERVICE_ACTIVE=%s\nSERVICE_RESULT=%s\nNEXT_RUN=%s\nLAST_TRIGGER=%s\nBACKUP_TIME=%s\n' \
      "$timer_active" "$service_active" "$service_result" "${next_run:-غير متاح}" "${last_trigger:-غير متاح}" "$backup_time"
    ;;
  *)
    echo "Usage: hded-backup-control {start|set-schedule|set-time HH:MM|enable|disable|status}" >&2
    exit 2
    ;;
esac
